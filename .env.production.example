APP_URL=https://rental.example.com
DOMAIN=rental.example.com
ACME_EMAIL=ops@example.com
VITE_DEFAULT_LANG=en

JWT_ACCESS_SECRET=replace-with-a-unique-32-character-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-unique-32-character-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=replace-with-a-unique-32-character-cookie-secret

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=no-reply@rental.example.com

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://rental.example.com/api/auth/google/callback

STORAGE_DRIVER=cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
