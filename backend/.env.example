# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database and cache
MONGO_URL=mongodb://localhost:27017/kit
REDIS_URL=redis://localhost:6379

# Authentication (use unique, securely generated values of at least 32 characters)
JWT_ACCESS_SECRET=replace-with-a-secure-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-secure-refresh-secret-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=replace-with-a-secure-cookie-secret

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=no-reply@example.com

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# File storage. Set to `fake` for local development, or `cloudinary` to enable Cloudinary.
STORAGE_DRIVER=fake
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# number of reverse proxies in front of the app (0 locally)
TRUST_PROXY=0
